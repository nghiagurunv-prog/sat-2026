# ============================================================================
#  BIẾN MÔI TRƯỜNG PRODUCTION — SAT.Guru (sao chép thành .env.local khi chạy dev)
#  KHÔNG commit .env.local — đã được .gitignore che (.env*).
# ============================================================================

# --- 1. Supabase (Auth + Database) — BẮT BUỘC ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# SERVER-ONLY: tuyệt đối KHÔNG đặt tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- 2. URL Ứng Dụng (dùng cho Webhook/Return URL, OpenGraph, Sitemap) ---
# Dùng tạm domain Vercel hoặc đổi sang tên miền riêng khi gắn custom domain.
NEXT_PUBLIC_APP_URL=https://sat-2026.vercel.app
APP_BASE_URL=https://sat-2026.vercel.app

# --- 3. AI Providers (Multi-LLM Router: ưu tiên Gemini 2.5 Flash, failover OpenAI) ---
GEMINI_API_KEY=<google-ai-studio-key>
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# (Tùy chọn) Proxy nếu server gọi thẳng OpenAI bị chặn vùng:
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
# Trần ngân sách AI toàn hệ thống/ngày (USD) — vượt trần tự ngắt kill-switch:
AI_DAILY_BUDGET_USD=5
# Model gói Ultimate & fair-use trần lượt gpt-4o/ngày/user (vượt trần tự hạ mềm về Flash):
ULTIMATE_AI_MODEL=gpt-4o
ULTIMATE_GPT4O_DAILY_CAP=60

# --- 4. Bảo Mật, Admin & Vercel Cron — BẮT BUỘC TRÊN PRODUCTION ---
# Anti-cheat HMAC ký dữ liệu tiến trình (sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SAT_PREP_SECRET=<chuỗi-ngẫu-nhiên-64-hex>
# Shared-secret bảo vệ /api/admin/* (fail-closed 403 nếu thiếu)
ADMIN_SECRET=<chuỗi-ngẫu-nhiên-mạnh>
# Bảo vệ toàn bộ /api/cron/* (Vercel tự gửi Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=<chuỗi-ngẫu-nhiên-32-byte-hex>

# --- 5. Distributed Rate-Limit (Upstash Redis — BẮT BUỘC trên Vercel multi-instance) ---
UPSTASH_REDIS_REST_URL=https://<your-upstash-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# --- 6. Cổng Thanh Toán payOS (VietQR Tự Động — KHUYÊN DÙNG LAUNCH V1 VN) ---
PAYOS_CLIENT_ID=<payos-client-id>
PAYOS_API_KEY=<payos-api-key>
PAYOS_CHECKSUM_KEY=<payos-checksum-key>

# --- 7. Cổng Thanh Toán Stripe (Thẻ Quốc Tế Visa/MasterCard) ---
# Lưu ý: VND là zero-decimal currency trên Stripe (KHÔNG ×100).
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx

# --- 8. Cổng Thanh Toán VNPay & MoMo (Tắt mặc định, mở khi có credentials doanh nghiệp) ---
# VNPAY_TMN_CODE=<tmn-code>
# VNPAY_HASH_SECRET=<hash-secret>
# VNPAY_HOST=https://sandbox.vnpayment.vn
# MOMO_PARTNER_CODE=<partner-code>
# MOMO_ACCESS_KEY=<access-key>
# MOMO_SECRET_KEY=<secret-key>
# MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create

# --- 9. Vận Hành, Cảnh Báo & Marketing ---
# Webhook Telegram/Discord/Slack nhận cảnh báo lỗi thanh toán & vận hành khẩn cấp:
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Webhook bridge gửi báo cáo tuần cho phụ huynh gói Ultimate (ZNS/Telegram/Email bridge):
PARENT_DIGEST_WEBHOOK_URL=https://your-webhook.example.com/parent-digest
# Danh sách mã giảm giá KOL/Affiliate bổ sung (phân cách bởi dấu phẩy):
# AFFILIATE_COUPONS=NGHIAGURU10,SAT2026
